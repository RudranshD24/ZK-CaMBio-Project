# === Datasets (never committed) ===
dataset/
*.tif
*.jpg
*.jpeg
*.png
*.bmp

# Allow docs screenshots
!docs/screenshots/*.png

# === Processed data (git-ignored, except split manifest) ===
data/processed/*
!data/processed/split_manifest.json
!data/processed/finger_train_val_split.json
!data/processed/validation_threshold_curve.json

# === Model weights ===
*.pt
*.pth
*.onnx

# === Results binary artifacts ===
results/**/*.npy

# === Python ===
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/
.venv/
venv/

# === Environment / secrets ===
.env
.env.*
!.env.example

# === C++ build ===
cpp/build/
cpp/out/
*.pyd
*.so
*.dll
*.lib
*.exp
*.obj

# === IDE ===
.vscode/
.idea/
*.swp
*.swo

# === OS ===
Thumbs.db
desktop.ini
.DS_Store

# === Docker ===
docker/*.log
