# ZK-CaMBio Deployment Environment Variables
# Copy to .env and configure strong production secrets.
# .env is explicitly excluded from git tracking (.gitignore).

# Environment mode: "false" for strict production, "true" for local test/debug
DEV_MODE=false

# Master secret key (minimum 32 bytes). Required when DEV_MODE=false.
# The server refuses to start with default/insecure keys outside DEV_MODE=true.
SERVER_MASTER_KEY=your_production_master_key_min_32_bytes_long_random_hex!

# API Bearer token for authenticating client requests (/enroll, /verify, /identify, /revoke)
API_TOKEN=your_secure_bearer_token_min_32_characters_long_random!

# Database credentials (Postgres)
POSTGRES_USER=cambio
POSTGRES_PASSWORD=your_strong_production_postgres_password
POSTGRES_DB=cambio
DATABASE_URL=postgresql+psycopg2://cambio:your_strong_production_postgres_password@db:5432/cambio
