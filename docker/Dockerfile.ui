FROM python:3.13-slim
# UI service image — Streamlit dashboard for Phase 8
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir streamlit==1.64.0 requests pillow numpy
COPY src/ src/
EXPOSE 8501
CMD ["streamlit", "run", "src/ui/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
